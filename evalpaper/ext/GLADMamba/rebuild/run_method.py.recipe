# GLADMamba training / evaluation: main.py:96-158 for one trial, line by line
# =============================================================================================
def fit(C, model, optimizer):
    args, device = C.args, C.device
    dataloader, dataloader_test = C.dataloader, C.dataloader_test
    hbs = [b.to(device) for b in C.hold_batches]
    start_epoch = 1
    weight_g = weight_n = mean_g = std_g = mean_n = std_n = None
    if C.state is not None:   # CHANGE: resume (model, optimizer, RNG, trajectory, loop-carried adaptive stats)
        st = C.state
        model.load_state_dict(st["model"])
        optimizer.load_state_dict(st["opt"])
        C.traj, C.train_loss = st["traj"], st["train_loss"]
        C.S.update(st["S"])
        mean_g, std_g, mean_n, std_n = st["adapt"]
        start_epoch = st["epoch"] + 1
        set_rng_state(st["rng"])
    payload = lambda: dict(model=model.state_dict(), opt=optimizer.state_dict(), adapt=(mean_g, std_g, mean_n, std_n))

