def load_model_module():
    if OVERLAY not in sys.path:
        sys.path.append(OVERLAY)       # appended: the ubgold-gpu venv keeps precedence
    spec = importlib.util.spec_from_file_location("gladmamba_model", osp.join(SRC, "model.py"))
    mod = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(mod)
    return mod


def load_metric():
    spec = importlib.util.spec_from_file_location("ubgold_metric", osp.realpath(UBGOLD_METRIC))
    mod = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(mod)
    return mod


