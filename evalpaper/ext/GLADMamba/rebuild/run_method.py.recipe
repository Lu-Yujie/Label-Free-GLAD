def save_scores(path, epochs, S, extra):
    os.makedirs(osp.dirname(path), exist_ok=True)
    arrs = dict(epochs=np.asarray(epochs, dtype=np.int64))
    for k, v in S.items():
        arrs[k] = np.stack([np.asarray(r, dtype=np.float64) for r in v], 0) if len(v) else np.zeros((0, 0))
    arrs.update(extra)
    tmp = path + ".tmp.npz"
    np.savez_compressed(tmp, **arrs)
    os.replace(tmp, path)


def peak_mem():
    out = dict(maxrss_gb=resource.getrusage(resource.RUSAGE_SELF).ru_maxrss / 1024 ** 2)
    if torch.cuda.is_available():
        out["cuda_max_alloc_gb"] = torch.cuda.max_memory_allocated() / 1024 ** 3
        out["cuda_max_reserved_gb"] = torch.cuda.max_memory_reserved() / 1024 ** 3
    return out


def chunks(lst, n):
    n = max(1, int(n))
    return [lst[i:i + n] for i in range(0, len(lst), n)]


TEST_STOP_EPOCH = int(os.environ.get("EP_TEST_STOP_EPOCH", "0"))   # resume tests only


# ----------------------------------------------------------------------------------------
# data: GLADMamba's own loaders on UB-GOLD's folds
# ----------------------------------------------------------------------------------------
def load_fold(args, DS, fold, dfn=None):
    """GLADMamba's get_ad_split_TU / get_ad_dataset_TU (verbatim), asserted against the UB-GOLD index lists."""
    dfn = dfn or load_data_functions()
    if DS.startswith("Tox21"):
        raise NotImplementedError("Tox21 is optional for E5 and not wired (fixed split, see NOTES.md)")
    splits = dfn["get_ad_split_TU"](args, fold=args.num_trial)
    dataloader, dataloader_test, meta = dfn["get_ad_dataset_TU"](args, splits[fold])
    ref = json.load(open(osp.join(SPLITS, f"{DS}.json")))
    rf = ref["folds"][fold]
    assert list(map(int, splits[fold][0])) == list(map(int, rf["split_train_index"])), "train split != UB-GOLD"
    assert list(map(int, splits[fold][1])) == list(map(int, rf["split_test_index"])), "test split != UB-GOLD"
    assert [int(d.y) for d in dataloader_test.dataset] == list(map(int, rf["y_test"])), "test labels != UB-GOLD"
    return splits, dataloader, dataloader_test, meta


