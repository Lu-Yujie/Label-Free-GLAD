def released_lines():
    """{DS: (script file, line, tokens)} for every `python main.py -exp_type ad ...` line in src/script/."""
    out = {}
    for fn in sorted(os.listdir(osp.join(SRC, "script"))):
        if not fn.endswith(".sh"):
            continue
        for raw in open(osp.join(SRC, "script", fn)):
            s = raw.strip()
            if not re.match(r"^python3? +main\.py", s):
                continue
            toks = shlex.split(s, comments=True)[2:]
            if "-exp_type" in toks and toks[toks.index("-exp_type") + 1] == "ad" and "-DS" in toks:
                out.setdefault(toks[toks.index("-DS") + 1], ("script/" + fn, s, toks))
    return out


def modal_config(ns=None):
    """Per option, the most frequent effective (parsed) value over ALL released ad lines (12: 8 TU + 4 Tox21);
    ties -> the repo default if it is among the tied values, else the smaller value (deep_rerun/A1 tie rule)."""
    ns = ns or load_main_functions()
    lines = released_lines()
    parsed = [vars(parse_gm(t, ns)) for _, (_, _, t) in sorted(lines.items())]
    default = vars(parse_gm([], ns))
    out, votes = {}, {}
    for k in default:
        if k in MODAL_SKIP:
            continue
        cnt = Counter(d[k] for d in parsed)
        top = max(cnt.values())
        tied = [v for v, c in cnt.items() if c == top]
        out[k] = default[k] if default[k] in tied else sorted(tied, key=lambda v: (str(type(v)), v))[0]
        votes[k] = dict(cnt)
    return out, votes, len(parsed)


def resolve_hparams(DS, hp):
    ns = load_main_functions()
    lines = released_lines()
    notes = []
    if hp == "ubgold":
        if DS in lines:
            fn, line, toks = lines[DS]
            return parse_gm(toks, ns), f"{fn}: {line}", notes
        mc, _, n = modal_config(ns)
        args = parse_gm(["-exp_type", "ad", "-DS", DS], ns)
        changed = []
        for k, v in mc.items():
            if getattr(args, k) != v:
                changed.append(f"{k} {getattr(args, k)}->{v}")
                setattr(args, k, v)
        notes.append(f"no released line for {DS}: modal released configuration over {n} ad lines: " + ", ".join(changed))
        return args, f"MODAL (no released line for {DS}) " + " ".join(f"-{k} {v}" for k, v in sorted(mc.items())), notes
    assert hp == "hpfree", hp
    args = parse_gm(["-exp_type", "ad", "-DS", DS], ns)
    if DS in lines:
        rel = parse_gm(lines[DS][2], ns)
        for k in ("batch_size", "batch_size_test"):
            if getattr(rel, k) != getattr(args, k):
                notes.append(f"hpfree: {k} {getattr(args, k)} -> {getattr(rel, k)} (per-dataset released value kept, A1 rule 2 analogue)")
                setattr(args, k, getattr(rel, k))
    for k in HPFREE_CRASH_FALLBACK.get(DS, []):
        mc, _, _ = modal_config(ns)
        notes.append(f"hpfree crash fallback: {k}={getattr(args, k)} -> modal {mc[k]}")
        setattr(args, k, mc[k])
    return args, ("HPFREE main.py defaults -DS " + DS + f"  [batch_size {args.batch_size} batch_size_test "
                  f"{args.batch_size_test}]"), notes


# ----------------------------------------------------------------------------------------
# metrics / RNG / checkpoint utilities (copies of the harness helpers)
# ----------------------------------------------------------------------------------------
def eval_metrics(metric, y, s):
    y = np.asarray(y).ravel()
    s = np.asarray(s, dtype=np.float64).ravel()
    if not np.all(np.isfinite(s)):
        return dict(auroc=float("nan"), auprc=float("nan"), fpr95=float("nan"), nonfinite=int((~np.isfinite(s)).sum()))
    return dict(auroc=float(metric.ood_auc(y, s)), auprc=float(metric.ood_aupr(y, s)),
                fpr95=float(metric.fpr95(y, s)), nonfinite=0)


def finite_mean(t):
    t = np.asarray(t, dtype=np.float64).ravel()
    return float(t.mean()) if t.size and np.all(np.isfinite(t)) else float("nan")


def rng_state():
    st = dict(py=random.getstate(), np=np.random.get_state(), torch=torch.get_rng_state())
    if torch.cuda.is_available():
        st["cuda"] = torch.cuda.get_rng_state_all()
    return st


def set_rng_state(st):
    random.setstate(st["py"])
    np.random.set_state(st["np"])
    torch.set_rng_state(st["torch"])
    if "cuda" in st and torch.cuda.is_available():
        torch.cuda.set_rng_state_all(st["cuda"])


