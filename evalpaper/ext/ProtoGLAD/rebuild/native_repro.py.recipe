os.environ.setdefault("TQDM_DISABLE", "1")   # CHANGE (D5)

HERE = osp.dirname(osp.abspath(__file__))
PG_SRC = osp.join(HERE, "src")
NATIVE = (os.environ.get("GLAD_DATA_ROOT", "glad_data") + "/ext_protoglad/native")
NATIVE_ATTR = {"AIDS": "node attribute", "BZR": "node attribute", "COX2": "node attribute", "DD": "node label",
               "MUTAG": "node label", "PROTEINS_full": "node attribute", "NCI1": "node label", "DHFR": "node label",
               "IMDB-BINARY": "degree", "REDDIT-BINARY": "degree"}

U protoglad/experiments/run_detection.py 363 1 [0]
O 15
    ap = argparse.ArgumentParser()
    ap.add_argument("--ds", required=True)
    ap.add_argument("--attr", default=None)
    ap.add_argument("--threads", type=int, default=int(os.environ.get("EP_THREADS", "1")))
    ap.add_argument("--tag", default="", help="separate run dir run_<DS>_<tag> (e.g. gpu)")
    a = ap.parse_args()
    attr = a.attr or NATIVE_ATTR.get(a.ds, "degree")
    run_dir = osp.join(NATIVE, f"run_{a.ds}" + (f"_{a.tag}" if a.tag else ""))
    if osp.exists(run_dir):
        shutil.rmtree(run_dir)                       # never resume (RNG stream, see docstring)
    os.makedirs(run_dir)
    os.makedirs(osp.join(run_dir, "data"))
    os.symlink(osp.join(NATIVE, "data", "TUDataset"), osp.join(run_dir, "data", "TUDataset"))
    os.chdir(run_dir)

