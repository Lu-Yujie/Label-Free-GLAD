            gb = gridbest_path(DS, features)
            if not osp.exists(gb):
                raise FileNotFoundError(f"grid replay for {DS} ({features}) not complete: {gb}")
            G = json.load(open(gb))
            p = dict(G["best_params"])
            line = "ProtoGLAD tuned: test-grid-best of the replayed 144-cell search (own rule, TEST-LABEL SELECTED)"
            meaning = "test-grid-best (replay of the method's own test-AUC grid search; upper bound)"
    p = dict(h=int(p["h"]), psi1=int(p["psi1"]), psi2=int(p["psi2"]), tau=float(p["tau"]))
    line = line + " | " + " ".join(f"{k}={v}" for k, v in p.items())
    return p, fixed, line, meaning


