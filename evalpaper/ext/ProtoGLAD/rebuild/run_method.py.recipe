def load_fold(H, DS, fold, holdout_frac=0.2):
    """CHANGE (D2): UB-GOLD trial `fold` exactly as the harness: set_seed(3407+fold), then UB-GOLD's own
    get_ad_split_TU / get_ad_dataset_TU (asserted against ubgold_splits), then the 20% held-out carve-out
    RandomState(2026+1000*fold). Returns the 80% fit list, the held-out list, the test list (UB-GOLD order) and the
    TU dataset indices of each graph (for the native-feature diagnostic)."""
    ns = H.load_ubgold_data_functions()
    ns["set_seed"](3407 + fold)
    assert not DS.startswith("Tox21"), "Tox21 not supported by this adapter"
    uargs = types.SimpleNamespace(DS=DS, num_trial=5, batch_size=128, batch_size_test=9999)   # loaders never iterated
    cwd = os.getcwd()
    os.chdir(H.DATA_RUN)
