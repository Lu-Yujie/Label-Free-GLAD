def run(DS, fold, hp="ubgold", features="ubgold", holdout_frac=0.2, tag="", verbose=True):
    t_start = time.time()
    run_id = (f"{METHOD}_{DS}_fold{fold}" + ("_hpfree" if hp == "hpfree" else "")
              + ("_nativefeat" if features == "native" else "") + (f"_{tag}" if tag else ""))
    os.makedirs(PARTS, exist_ok=True)
    out_json = osp.join(PARTS, run_id + ".json")
    if osp.exists(out_json):
        print(f"[skip] {out_json} exists")
        return "done"
    H = load_harness()
    lockdir = osp.join(ROOT, "locks")
    os.makedirs(lockdir, exist_ok=True)
    lock = osp.join(lockdir, run_id + ".lock")
    if not H.acquire_lock(lock):
        print(f"[locked] {run_id} is running in another job")
        return "locked"
