_NATIVE_CACHE = {}


def native_features(P, DS):
    """ProtoGLAD's own loader (verbatim) with its released per-dataset feature choice; diagnostic only."""
    if DS not in _NATIVE_CACHE:
        attr = NATIVE_ATTR.get(DS, "degree")
        adj_list, feat_list, _labels = P.data.load_tu_dataset(DS, attr, data_root=NATIVE_DATA_ROOT)
        _NATIVE_CACHE[DS] = (attr, adj_list, feat_list)
    return _NATIVE_CACHE[DS]


def fold_graphs(P, F, DS, features):
    """(adj, x) lists for fit / held-out / test graphs."""
    fit = [to_protoglad(d) for d in F["fit_list"]]
    hold = [to_protoglad(d) for d in F["hold_list"]]
    test = [to_protoglad(d) for d in F["test_list"]]
    if features == "ubgold":
        return fit, hold, test, "ubgold"
    assert features == "native", features
    attr, adj_list, feat_list = native_features(P, DS)
    out = []
    for ub, idx in ((fit, F["fit_tu"]), (hold, F["hold_tu"]), (test, F["test_tu"])):
        lst = []
        for (a_ub, _x), i in zip(ub, idx):
            a = adj_list[i]
            assert a.shape == a_ub.shape and (a != a_ub).nnz == 0, (DS, i)   # same graph as UB-GOLD's
            lst.append((a, feat_list[i]))
        out.append(lst)
    return out[0], out[1], out[2], f"native:{attr}"


