    rf = ref["folds"][fold]
    train_index = list(map(int, splits[fold][0]))
    test_index = list(map(int, splits[fold][1]))
    assert train_index == list(map(int, rf["split_train_index"]))
    assert test_index == list(map(int, rf["split_test_index"]))
    train_all = list(dataloader.dataset)
    # TU indices of UB-GOLD's training normals (get_ad_dataset_TU keeps train graphs with y != 0, in split order)
    raw_y_train = [int(d.y) for d in dataset_train]
