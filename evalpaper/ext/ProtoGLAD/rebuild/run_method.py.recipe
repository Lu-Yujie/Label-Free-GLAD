def _run(H, DS, fold, hp, features, run_id, out_json, holdout_frac, verbose, t_start):
    metric = load_ubgold_metric(H)
    P = load_protoglad()
    p, fixed, hp_line, meaning = resolve_hparams(P, DS, hp, features)
    seed = 3407 + fold
    F = load_fold(H, DS, fold, holdout_frac)
    fit, hold, test, feat_desc = fold_graphs(P, F, DS, features)
    y_test = F["y_test"]
    device = "cuda" if torch.cuda.is_available() else "cpu"

    X_train, X_test, X_hold, tim1 = stage1(P, H, fit, hold, test, p["psi1"], p["h"], seed)
    res = stage2(P, H, X_train, X_test, X_hold, y_test, p["psi2"], p["tau"])
    assert res is not None
    test_scores, hold_scores = res["test_scores"], res["hold_scores"]

    rec = H.eval_metrics(metric, y_test, test_scores)
    rec["holdout_score"] = H.finite_mean(hold_scores)
    rec["holdout_loss"] = rec["holdout_score"]
    rec.update(epoch=1, auroc_protoglad=float(res["auc"]), n_prototypes=int(res["n_prototypes"]),
               t=time.time() - t_start, timings=dict(tim1, **res["timings"]),
               test_scores_sha=arr_sha(test_scores), hold_scores_sha=arr_sha(hold_scores))

    # the same cell in the grid replay (if present) must be bit-identical (same seed, same code path)
    unit = grid_unit_paths(DS, fold, p["psi1"], features)[1]
    grid_check = None
    if osp.exists(unit):
        Z = np.load(unit)
        cells = [tuple(c) for c in Z["cells"].tolist()]
        key = (float(p["h"]), float(p["psi1"]), float(p["psi2"]), float(p["tau"]))
        if key in cells:
            j = cells.index(key)
            grid_check = bool(np.array_equal(Z["test"][j], test_scores) and np.array_equal(Z["hold"][j], hold_scores))
            assert grid_check, f"{run_id}: differs from its grid-replay cell"
    if verbose:
        print(f"[{run_id}] {hp_line} | feat {feat_desc} | auroc {rec['auroc']:.4f} (sklearn {res['auc']:.4f}) "
              f"auprc {rec['auprc']:.4f} hold {rec['holdout_score']:.4f} n_proto {res['n_prototypes']} "
              f"grid_identical {grid_check} t={rec['t']:.1f}s", flush=True)

    meta_out = dict(method=METHOD, dataset=DS, fold=fold, hp=hp, seed=seed, run_id=run_id,
                    ubgold_sh_line=hp_line, hp_notes=[meaning], hp_meaning=meaning,
                    features=feat_desc,
                    hparams=dict(p, **fixed, num_epoch=1, eval_freq=1),
                    n_train_normal_ubgold=F["n_all"], n_fit=len(fit), n_holdout=F["n_hold"],
                    holdout_seed=H.HOLDOUT_SEED + 1000 * fold, n_test=len(test), n_test_anomalous=int(y_test.sum()),
                    max_nodes_num=int(F["meta"]["max_nodes_num"]), num_feat=int(F["meta"]["num_feat"]),
                    device=device, device_all=device, torch=torch.__version__,
                    cuda_name=(torch.cuda.get_device_name(0) if device == "cuda" else None),
                    threads=torch.get_num_threads(), max_epochs_override=None,
                    protoglad_commit=PG_COMMIT, harness_run_eval_sha256=sha256(osp.join(HARNESS, "run_eval.py")),
                    adapter_sha256=sha256(osp.abspath(__file__)), grid_identical=grid_check,
                    job=os.environ.get("SLURM_JOB_ID"), host=os.uname().nodename,
                    impl="ProtoGLAD src@f7d8ce9 + D1 (IK CPU fallback), D2 (UB-GOLD folds/features, held-out "
                         "scoring), D3 (no node-embedding list), D5 (tqdm off); UB-GOLD folds via harness run_eval.py")
    meta_out["seconds"] = time.time() - t_start
    meta_out["n_eval"] = 1
    meta_out["memory"] = H.peak_mem()
    meta_out["completed"] = time.strftime("%Y-%m-%d %H:%M:%S")
    npz = osp.join(SCORES, run_id + ".npz")
    H.save_scores(npz, [1], {"test": [test_scores], "hold": [hold_scores]}, dict(
        y_test=y_test, test_index=np.asarray(F["split_test_index"], dtype=np.int64),
        hold_pos=np.asarray(F["hold_pos"], dtype=np.int64),
        test_n_nodes=np.array([int(d.num_nodes) for d in F["test_list"]], dtype=np.int64),
        test_n_edges=np.array([int(d.edge_index.size(1)) // 2 for d in F["test_list"]], dtype=np.int64),
        hold_n_nodes=np.array([int(d.num_nodes) for d in F["hold_list"]], dtype=np.int64),
        hold_n_edges=np.array([int(d.edge_index.size(1)) // 2 for d in F["hold_list"]], dtype=np.int64),
        num_epoch=np.int64(1), eval_freq=np.int64(1)))
    meta_out["scores_npz"] = npz
    out = dict(meta=meta_out, traj=[rec], train_loss=[])
    tmp = out_json + ".tmp"
    with open(tmp, "w") as f:
        json.dump(out, f)
    os.replace(tmp, out_json)
    print(f"[done] {run_id} in {meta_out['seconds']:.0f}s -> {out_json}", flush=True)
    return "done"


# ----------------------------------------------------------------------------------------------
# grid replay of hyperparam_search (run_detection.py l.167-272) on the UB-GOLD folds
# ----------------------------------------------------------------------------------------------
def grid_unit_paths(DS, fold, psi1, features):
    d = osp.join(GRID, features, DS)
    stem = osp.join(d, f"fold{fold}_psi1_{psi1}")
    return stem + ".json", stem + ".npz"


def run_grid_unit(DS, fold, psi1, features="ubgold", holdout_frac=0.2, verbose=True):
    """Stage 1 once for (fold, psi1); RNG state saved after it and restored before every (psi2, tau) cell, which is
    exactly the from-scratch pipeline with set_seed(3407+fold) per cell (NOTES.md; checked by verify.py)."""
    t_start = time.time()
    js, npz = grid_unit_paths(DS, fold, psi1, features)
    if osp.exists(js):
        print(f"[skip] {js} exists")
        return "done"
    os.makedirs(osp.dirname(js), exist_ok=True)
    H = load_harness()
    lock = js + ".lock"
    if not H.acquire_lock(lock):
        print(f"[locked] {js}")
        return "locked"
