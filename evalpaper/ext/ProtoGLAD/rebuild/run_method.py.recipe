def sha256(path):
    return hashlib.sha256(open(path, "rb").read()).hexdigest()


def arr_sha(a):
    return hashlib.sha256(np.ascontiguousarray(a).tobytes()).hexdigest()[:16]


def load_harness():
    """Import evalpaper/harness/run_eval.py as a module (read-only use of its data/RNG/IO helpers)."""
    spec = importlib.util.spec_from_file_location("ep_harness_run_eval", osp.join(HARNESS, "run_eval.py"))
    H = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(H)
    return H


_SET_SEED = {}


def ubgold_set_seed(H):
    """UB-GOLD's set_seed (benchmark/mymain.py), extracted verbatim by the harness."""
    if "f" not in _SET_SEED:
        _SET_SEED["f"] = H.load_ubgold_data_functions()["set_seed"]
    return _SET_SEED["f"]


def load_ubgold_metric(H):
    if H.SRC not in sys.path:
        sys.path.append(H.SRC)
    H.stub_package("GAOOD", osp.join(H.SRC, "GAOOD"))
    importlib.import_module("GAOOD.metric")
    return importlib.import_module("GAOOD.metric.metric")


def load_protoglad(with_run_detection=False):
    """Import ProtoGLAD's modules from src/ and apply the runtime override D1."""
    if PG_SRC not in sys.path:
        sys.path.insert(0, PG_SRC)
    P = types.SimpleNamespace()
    P.cfg = importlib.import_module("protoglad.config")
    P.data = importlib.import_module("protoglad.data")
    P.emb = importlib.import_module("protoglad.embedding")
    P.det = importlib.import_module("protoglad.detector")
    P.ik = importlib.import_module("protoglad.ik_inne_gpu")
    if with_run_detection:   # verification only (it prepends src/protoglad to sys.path; removed again)
        saved = list(sys.path)
        P.rd = importlib.import_module("protoglad.experiments.run_detection")
        sys.path[:] = saved
    for mod in (P.cfg, P.data, P.emb, P.det, P.ik):
        assert osp.realpath(mod.__file__).startswith(osp.realpath(PG_SRC)), mod.__file__

    # CHANGE (D1): IK_inne_gpu.__init__ raises "CUDA is not available." without a GPU. Copy of __init__ with a CPU
    # fallback; every other line of the class runs unchanged on self.device.
    def _ik_init(self, psi, t) -> None:
        self.device = torch.device("cuda") if torch.cuda.is_available() else torch.device("cpu")
