def grid_cells():
    return list(itertools.product(GRID_SPACE["h"], GRID_SPACE["psi1"], GRID_SPACE["psi2"], GRID_SPACE["tau"]))


def gridbest_path(DS, features):
    return osp.join(GRID_RES, f"{DS}{'' if features == 'ubgold' else '_native'}_gridbest.json")


def resolve_hparams(P, DS, hp, features="ubgold"):
    cfg = P.cfg
    fixed = dict(t1=cfg.DEFAULT_T1, t2=cfg.DEFAULT_T2, rho=cfg.DEFAULT_RHO, top_k=cfg.DEFAULT_TOP_K)
    if hp == "hpfree":
        p = dict(h=cfg.DEFAULT_WL_ITERS, psi1=cfg.DEFAULT_PSI1, psi2=cfg.DEFAULT_PSI2, tau=cfg.DEFAULT_TAU)
        line = "ProtoGLAD hpfree: repository defaults (config.py = run_detection.py argparse defaults)"
        meaning = "repository defaults"
