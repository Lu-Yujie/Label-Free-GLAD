    n_hold = int(round(holdout_frac * n_all))
    perm = np.random.RandomState(H.HOLDOUT_SEED + 1000 * fold).permutation(n_all)
    hold_pos = sorted(perm[:n_hold].tolist())
    fit_pos = sorted(perm[n_hold:].tolist())
