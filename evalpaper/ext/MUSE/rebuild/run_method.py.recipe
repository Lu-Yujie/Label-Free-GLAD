        model.load_state_dict(st["model"]); feature_head.load_state_dict(st["feature_head"])
        edge_head.load_state_dict(st["edge_head"]); self.optimizer.load_state_dict(st["opt"])
        self.scheduler.load_state_dict(st["sched"])
        train_graphs = np.array(st["train_graphs"])
        total_loss = st["total_loss"]
        start = restore_common(C) - 1                               # 0-based ep of the next epoch
        set_rng_state(st["rng"])
    payload = lambda: dict(model=model.state_dict(), feature_head=feature_head.state_dict(),
                           edge_head=edge_head.state_dict(), opt=self.optimizer.state_dict(),
                           sched=self.scheduler.state_dict(), train_graphs=train_graphs.copy(),
