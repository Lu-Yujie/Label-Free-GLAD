# ----------------------------------------------------------------------------------------------
# code loading
# ----------------------------------------------------------------------------------------------
def load_muse():
    """Import MUSE's GNNs.py and src.py from ./src under private names (no edits, no bytecode). data_loader.py
    is not imported: its only function used here (prepare_data) is copied below, and its unused import
    `torch_geometric.utils.subgraph` does not exist as a module in PyG 2.6.1."""
    mods = {}
    for name in ("GNNs", "src"):
        mname = "muse_" + name
        if mname in sys.modules:
            mods[name] = sys.modules[mname]
            continue
        spec = importlib.util.spec_from_file_location(mname, osp.join(MUSE_SRC, name + ".py"))
        m = importlib.util.module_from_spec(spec)
        sys.modules[mname] = m
        spec.loader.exec_module(m)
        mods[name] = m
    return mods


def load_ubgold_metric():
    spec = importlib.util.spec_from_file_location("ubgold_metric", osp.join(UBGOLD_SRC, "GAOOD", "metric", "metric.py"))
    m = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(m)
    return m


def extract_functions(path, names, ns):
    tree = ast.parse(open(path).read())
    funcs = [n for n in tree.body if isinstance(n, ast.FunctionDef) and n.name in names]
    assert sorted(f.name for f in funcs) == sorted(names), [f.name for f in funcs]
    exec(compile(ast.Module(body=funcs, type_ignores=[]), path, "exec"), ns)
    return ns


