def muse_train(C, self, model, feature_head, edge_head, train_idxs, lr, weight_decay, epochs, batch_size, seed,
               evaluate):
    """src/src.py MUSE_representation_learning.train(), line by line; `self` is the MUSE trainer object.
    CHANGE: at every snapshot epoch the snapshot is evaluated (rng-isolated) instead of being appended to a
    list; checkpoint/resume after every epoch boundary (NOTES 1.6.2)."""
