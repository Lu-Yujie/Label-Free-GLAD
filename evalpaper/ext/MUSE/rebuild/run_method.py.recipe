        C.train_loss.append((TL1 + TL2) / len(train_idxs))
        C.t_train += time.time() - t0
        epoch = ep + 1
        if epoch in C.eval_epochs:                                # int(ep + 1) % saving_interval == 0
            evaluate(epoch, time.time())                          # CHANGE: evaluate the snapshot now
        if maybe_stop(C, epoch, payload):
