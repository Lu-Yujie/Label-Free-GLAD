def released_configs():
    """MUSE_hyperparameters.pickle, read with a class-blocking Unpickler (plain dicts/floats/ints)."""
    class _Safe(pickle.Unpickler):
        def find_class(self, module, name):
            raise pickle.UnpicklingError(f"blocked {module}.{name}")
    with open(osp.join(MUSE_SRC, "MUSE_hyperparameters.pickle"), "rb") as f:
        return _Safe(io.BytesIO(f.read())).load()


def modal_anom0(rel):
    """Per option, the mode over the 10 released anom_0 entries; ties -> smaller value (A1 rule)."""
    out = {}
    for k in ("lr", "dim", "layer", "gamma"):
        cnt = Counter(v["anom_0"][k] for v in rel.values())
        top = max(cnt.values())
        out[k] = sorted(v for v, c in cnt.items() if c == top)[0]
