        assert len(an) == len(td.groups[k]) and len(P["test"][k]) == len(R.y[k])
        start = len(cont)
        cont += list(an)
        test_idx[k] = norm_idx + list(range(start, start + len(an)))
    graphs = [Data(x=d.x, edge_index=d.edge_index) for d in cont]
    for d, g in zip(graphs, cont):
        d.num_nodes = int(g.num_nodes)

    R.eval_epochs = set(range(M.FIXED["saving_interval"], num_epoch + 1, M.FIXED["saving_interval"])) | {num_epoch}
    hparams = dict(H, num_epoch=num_epoch, eval_freq=M.FIXED["saving_interval"], saving_interval=M.FIXED["saving_interval"],
                   dropout=M.FIXED["dp"], weight_decay=M.FIXED["w_decay"], edge_drop=M.FIXED["edge_drop"],
                   batch_size=H["bsize"], batch_size_test=H["bsize"], hidden_dim=H["dim"], num_layer=H["n_layers"],
                   mlp_hid=M.MLP_MAIN[0], mlp_lr=M.MLP_MAIN[1], mlp_layers=M.FIXED["mlp_layers"],
