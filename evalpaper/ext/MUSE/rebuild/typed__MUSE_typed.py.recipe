    gnn_trainer._SubsetSampler = S_.SubsetSampler

    R.load_state(device.split(":")[0], torch.get_num_threads(), first_epoch=1)
    slice_check = {}

    def error_scores(m_, fe_, ee_, curP, container, fit_idx_):
        """Snapshot -> error representations of `container` -> label-free MLP (main cell) -> anomaly scores."""
        ae = S_.MUSE_oneclass_classification(model=m_, feature_encoder=fe_, edge_encoder=ee_, datasets=container,
                                             device=device, B_size=BSize, labels=adj_of(container),
                                             pos_weights=pw_of(container))
        ae.obtain_error_representations(curP, fit_idx_)
        TX = ae.TX.detach().cpu().numpy().astype(np.float64)
        r4_dim, r4_lr = M.MLP_MAIN
U src.py 109 3 [8,8,8]
O 52
        mlp = G.AutoEncoderOneclassClassifier(in_dim=M.FIXED["n_feat_err"], hid_dim=r4_dim,
                                              n_layers=M.FIXED["mlp_layers"], drop_p=M.FIXED["mlp_drop"]).to(device)
        stds, l_fin = M.fit_mlp_labelfree(ae, mlp, fit_idx_, r4_lr, M.FIXED["mlp_epochs"], M.FIXED["mlp_wd"], seed)
        norm_all = M.muse_normality(ae, list(range(len(container))), mlp, stds)
        return -norm_all.astype(np.float64), TX, l_fin

    pos_of = {id(g): i for i, g in enumerate(graphs)}

    def adj_of(container):
        return adj if container is graphs else [adj[pos_of[id(g)]] for g in container]

    def pw_of(container):
        return adj_pos_weights if container is graphs else [adj_pos_weights[pos_of[id(g)]] for g in container]

    def evaluate(epoch, t1):
        """Snapshot `epoch` (port's evaluate, CHANGE-TYPED: main MLP cell only, per-group slices)."""
        with M.rng_isolated():
            curP = [copy.deepcopy(model.state_dict()), copy.deepcopy(feature_encoder.state_dict()),
                    copy.deepcopy(edge_encoder.state_dict())]
            m_, fe_, ee_ = copy.deepcopy(model), copy.deepcopy(feature_encoder), copy.deepcopy(edge_encoder)
            an, TX, l_fin = error_scores(m_, fe_, ee_, curP, graphs, fit_idx)
            nonfinite_rep = int((~np.isfinite(TX)).any(1).sum())
            hobj = M.heldout_objective(gnn_trainer, m_, fe_, ee_, hold_idx, BSize)
            if a.check_slice and not slice_check:      # smoke only: group alone in its own container
                k = keys[-1]
                own = [graphs[i] for i in fit_idx + hold_idx + test_idx[k]]
                an_own, _, _ = error_scores(copy.deepcopy(model), copy.deepcopy(feature_encoder),
                                            copy.deepcopy(edge_encoder), curP, own, fit_idx)
                d = np.abs(an_own[n_fit + n_hold:] - an[test_idx[k]])
                slice_check.update(group=k, epoch=epoch, max_abs_diff=float(np.nanmax(d)),
                                   max_rel_diff=float(np.nanmax(d / np.maximum(np.abs(an[test_idx[k]]), 1e-12))))
        R.record(epoch, {k: an[test_idx[k]] for k in keys}, an[hold_idx],
                 rec_extra=dict(holdout_obj=hobj, fitref_score=TC.finite_mean(an[fit_idx]), mlp_final_loss=l_fin,
                                nonfinite_rep=nonfinite_rep),
                 extra_S={"rep": TX.ravel()}, t_eval0=t1, metric=metric)

    # ---- src.py MUSE_representation_learning.train via the port's instrumented copy (muse_train) ------------
    st = M.muse_train(R, gnn_trainer, model, feature_encoder, edge_encoder, fit_idx, lr, M.FIXED["w_decay"],
                      num_epoch, BSize, seed, evaluate)
    if st != "done":
        return st
    return R.finish(num_epoch, M.FIXED["saving_interval"], expected_epochs=sorted(R.eval_epochs),
                    extra_npz=dict(n_fit=np.int64(n_fit), n_hold=np.int64(n_hold),
                                   rep_layout=np.array("rep: per eval point, graphs [fit | held-out | test normals | "
                                                       "anomalies of each group in group_order] x [avg_L1, std_L1, "
                                                       "avg_X, std_X]")),
                    meta_extra=dict(slice_check=slice_check or None))


if __name__ == "__main__":
    TC.main(METHOD, run, extra=lambda ap: ap.add_argument("--check_slice", action="store_true",
                                                          help="smoke: compare one group in its own container"))
