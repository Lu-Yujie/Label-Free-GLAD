def _run(H, DS, fold, hp, run_id, out_json, ckpath, holdout_frac, deadline, max_epochs, ckpt_every_s, verbose,
         t_start):
    metric = load_ubgold_metric(H)
    utils, layers, model_mod = load_gul()
    U_GLAD, compute_metrics = model_mod.U_GLAD, utils.compute_metrics
    deterministic = not torch.cuda.is_available()
    if deterministic:
        # CHANGE (D8): on CPU the backward of advanced indexing (GAE decoder z[edge_index[i]], index_put_
        # accumulate) uses parallel atomic adds -> run-to-run float differences. Deterministic mode only fixes the
        # summation order (bit-reproducible runs and exact resume); values are otherwise unchanged.
        torch.use_deterministic_algorithms(True, warn_only=True)
