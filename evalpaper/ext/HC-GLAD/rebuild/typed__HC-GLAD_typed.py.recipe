import typed_ext_common as TC

METHOD = "HC-GLAD"


def mem_estimate_gb(d, n_nodes, factor):
    """A19/A27 memory model of the dense node loss: factor * d * N^2 bytes (eval 4, training 8)."""
    return factor * d * float(n_nodes) ** 2 / 1e9


