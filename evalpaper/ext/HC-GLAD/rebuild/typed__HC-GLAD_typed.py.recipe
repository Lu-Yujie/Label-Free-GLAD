    def score_list(graphs, bs):   # port: held-out scoring, freshly collated chunks in fixed order (A3)
        out = []
        for ch in M.chunks(graphs, bs):
            M.housekeeping()
            data = Batch.from_data_list(ch).to(device)
            s, _ = score_batch(data)
            out.append(s.detach().cpu().numpy().astype(np.float64))
        return np.concatenate(out) if out else np.zeros(0)

