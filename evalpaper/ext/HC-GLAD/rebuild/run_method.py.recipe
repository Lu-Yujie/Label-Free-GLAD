def modal_config(ns=None):
    """Per option, the most frequent effective (parsed) value over ALL released ad lines (12: 8 TU + 4 Tox21);
    ties -> the repo default if it is among the tied values, else the smaller value (A1 / GLADMamba tie rule)."""
    ns = ns or load_main_functions()
    lines = released_lines()
    parsed = [vars(parse_hc(t, ns)) for _, (_, _, t) in sorted(lines.items())]
    default = vars(parse_hc([], ns))
    out, votes = {}, {}
    for k in default:
        if k in MODAL_SKIP:
U optimizers/radam.py 96 1 [12]
O 15
        cnt = Counter(d[k] for d in parsed)
        top = max(cnt.values())
        tied = [v for v, c in cnt.items() if c == top]
        out[k] = default[k] if default[k] in tied else sorted(tied, key=lambda v: (str(type(v)), v))[0]
        votes[k] = dict(cnt)
    return out, votes, len(parsed)


