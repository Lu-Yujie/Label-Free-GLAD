def save_scores(path, epochs, S, extra):
    os.makedirs(osp.dirname(path), exist_ok=True)
    arrs = dict(epochs=np.asarray(epochs, dtype=np.int64))
    for k, v in S.items():
        dt = np.float32 if k == "test_c" else np.float64
        arrs[k] = np.stack([np.asarray(r, dtype=dt) for r in v], 0) if len(v) else np.zeros((0, 0))
    arrs.update(extra)
    tmp = path + ".tmp.npz"
    np.savez_compressed(tmp, **arrs)
    os.replace(tmp, path)


def peak_mem():
    out = dict(maxrss_gb=resource.getrusage(resource.RUSAGE_SELF).ru_maxrss / 1024 ** 2)
    if torch.cuda.is_available():
        out["cuda_max_alloc_gb"] = torch.cuda.max_memory_allocated() / 1024 ** 3
        out["cuda_max_reserved_gb"] = torch.cuda.max_memory_reserved() / 1024 ** 3
    return out


def chunks(lst, n):
    n = max(1, int(n))
    return [lst[i:i + n] for i in range(0, len(lst), n)]


def unregistered_encoders(model):
    """HC-GLAD stores its 4 GNN/hypergraph encoders as bound `forward` methods (layers/hyp_layers.py:51-59), so
    they are not registered submodules: not in model.parameters() / state_dict(). Returned for checkpointing."""
    out = {}
    for branch in ("layers", "hypergraph_layers"):
        agg = getattr(model.encoder, branch)[0].agg
        for k in ("stackGCNs_f", "stackGCNs_s"):
            out[f"{branch}.{k}"] = getattr(agg, k).__self__
    return out


