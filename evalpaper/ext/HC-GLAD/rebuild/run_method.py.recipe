            # the training objective on the held-out graphs in chunks of the training batch_size)
            with rng_isolated(), torch.no_grad():
                hs = score_list(C.hold_list, min(args.batch_size_test, max(1, C.n_hold)))
                ho = score_list(C.hold_list, min(args.batch_size, max(1, C.n_hold)))

            rec = eval_metrics(C.metric, C.y_test, test)
            rec.update(auroc_own=auc_own, own_code_would_crash=own_crash,
                       holdout_score=finite_mean(hs), holdout_obj=finite_mean(ho),
                       n_hold_nonfinite=int((~np.isfinite(hs)).sum()), n_holdobj_nonfinite=int((~np.isfinite(ho)).sum()))
            for j, nm in enumerate(("g", "n", "g_hyper", "n_hyper")):
                rec["auroc_" + nm] = eval_metrics(C.metric, C.y_test, tc[:, j])["auroc"]
            rec["holdout_loss"] = rec["holdout_score"]       # deep_rerun naming (VAL-NORMAL signal)
            rec["epoch"] = epoch
            rec["train_loss"] = C.train_loss[-1]
            rec["t"] = time.time() - C.t_start
            C.traj.append(rec)
            for k, v in (("test", test), ("hold", hs), ("hold_obj", ho), ("test_c", tc)):
                C.S[k].append(np.asarray(v))
            C.t_eval += time.time() - t1
            if C.verbose:
                print(f"[{C.run_id}] ep {epoch} train {rec['train_loss']:.4f} test_auc {rec['auroc']:.4f} "
                      f"(own {auc_own:.4f}) hold {rec['holdout_score']:.4f} obj {rec['holdout_obj']:.4f} t={rec['t']:.0f}s", flush=True)
        if maybe_stop(C, epoch, payload):
            return "incomplete"
    return "done"


if __name__ == "__main__":
    ap = argparse.ArgumentParser()
    ap.add_argument("--method", default=METHOD)
    ap.add_argument("--dataset", required=True)
    ap.add_argument("--fold", type=int, required=True)
    ap.add_argument("--hp", default="ubgold", choices=["ubgold", "hpfree"])
    ap.add_argument("--holdout_frac", type=float, default=0.2)
    ap.add_argument("--deadline", type=float, default=None, help="unix time; checkpoint and exit after it")
    ap.add_argument("--max_epochs", type=int, default=None, help="smoke tests only (use with --tag)")
    ap.add_argument("--tag", default="")
    ap.add_argument("--threads", type=int, default=int(os.environ.get("EP_THREADS", "2")))
    ap.add_argument("--ckpt_every_s", type=float, default=300.0)
    ap.add_argument("--diag_orig", action="store_true",
                    help="reproduction diagnostic (requires --tag): 100%% training normals, seed trial+1, no held-out")
    ap.add_argument("--print_config", action="store_true", help="print the resolved configuration and exit")
    a = ap.parse_args()
    if a.print_config:
        args, line, notes = resolve_hparams(DS_ALIASES.get(a.dataset, a.dataset), a.hp)
        print(json.dumps(dict(line=line, notes=notes, args=vars(args)), default=str))
        sys.exit(0)
    if a.diag_orig and not a.tag:
        sys.exit("--diag_orig requires --tag (diagnostic runs must not be mistaken for grid runs)")
    if a.max_epochs is not None and not a.tag:
        sys.exit("--max_epochs requires --tag (smoke runs must not be mistaken for real runs)")
    torch.set_num_threads(a.threads)
    st = run(a.method, a.dataset, a.fold, hp=a.hp, holdout_frac=a.holdout_frac, deadline=a.deadline,
             max_epochs=a.max_epochs, ckpt_every_s=a.ckpt_every_s, tag=a.tag, diag_orig=a.diag_orig)
    sys.exit(0 if st == "done" else 3)
